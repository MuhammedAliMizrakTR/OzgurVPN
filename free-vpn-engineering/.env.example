# Documentation only. Do not copy a sample password into production.
# Run: python3 scripts/init_env.py
TROJAN_PASSWORD=
WS_PATH=/tunnel
PORT=10000
CORE_PORT=10001
EGRESS_TCP_PORTS=80,443
MAX_TUNNELS=16
HANDSHAKES_PER_MINUTE=60
HANDSHAKE_BURST=20
TUNNEL_IDLE_TIMEOUT=2m
TUNNEL_MAX_AGE=30m
LOG_LEVEL=warn
# Alternative: remove TROJAN_PASSWORD before setting TROJAN_USERS_JSON in Render.
# TROJAN_USERS_JSON=[{"name":"alice","password":"<a-unique-generated-secret>"}]
