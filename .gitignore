*.sqlite
*.sqlite3
*.sqlite-*
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# This is a source archive. .gitignore is not a secret scanner and does not
# protect files that were already tracked or manually uploaded via the web UI.
