/uploads/
/vds-local-tests/
*.zip
*.tar
*.tar.gz
*.tgz
*.log
vds-on-kontrol.*.txt
*.local.json

# Never publish live VDS data, generated credentials or client subscriptions.
clients/
secrets/
credentials/
mualiy-sui-live/
mualiy-eski-servisler-*/
mualiy-baglanti-*/
ozgur-vds-clients/
state.json
baglanti.txt
cloudflare.ini
tunnel-token
*credentials*.json
*.db
